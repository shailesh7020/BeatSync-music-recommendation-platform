# Database Connection
# PostgreSQL: postgresql://username:password@localhost:5432/music_platform
# SQLite (Local Dev Fallback): sqlite:///./music_platform.db
DATABASE_URL=postgresql://postgres:password@localhost:5432/music_platform

# Spotify Developer API Keys
# Get yours from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# YouTube Data API v3 Key
# Get yours from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Environment & Server Config
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="Music Recommendation Platform"
